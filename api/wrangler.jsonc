{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "excise-revenue-recovery-api",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "excise-revenue-recovery-db",
			"database_id": "4f3e37fd-006a-4bce-b2d3-4bfb8bb16248"
		}
	],
	// Unlock-request PDF attachments (ROADMAP.md Milestone 28) — private bucket, no public
	// access/CORS, no R2.dev URL; the only read path is the admin-authenticated attachment
	// route. Not the Next.js ISR incremental cache binding (this API has no ISR pages).
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "excise-revenue-recovery-attachments"
		}
	]
}
