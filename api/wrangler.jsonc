{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "excise-revenue-recovery-api",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "excise-revenue-recovery-db",
			"database_id": "4f3e37fd-006a-4bce-b2d3-4bfb8bb16248"
		}
	]
	// ponytail: no R2 incremental cache / images binding — this API has no ISR pages or
	// next/image usage. Add them back (see @opennextjs/cloudflare templates/wrangler.jsonc)
	// if that changes.
}
