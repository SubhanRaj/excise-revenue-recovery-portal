{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "excise-revenue-recovery-api",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "excise-revenue-recovery-db",
			"database_id": "4f3e37fd-006a-4bce-b2d3-4bfb8bb16248"
		}
	]
	// r2_buckets binding for unlock-request PDF attachments (ROADMAP.md Milestone 28) is
	// commented out for now — `wrangler deploy` hard-fails the *entire* Worker deploy with
	// [code: 10042] if this binding is present and the bucket doesn't exist yet (R2 isn't
	// enabled on the Cloudflare account — see R2_PDF_ATTACHMENT_REPROVISIONING.md). Safe to
	// leave commented: no reachable code path calls env.ATTACHMENTS right now (the DEO UI
	// never sends a PDF attachment). Uncomment this exact block, run `wrangler r2 bucket
	// create excise-revenue-recovery-attachments`, and redeploy once R2 is enabled — see that
	// doc for the full checklist.
	// "r2_buckets": [
	// 	{
	// 		"binding": "ATTACHMENTS",
	// 		"bucket_name": "excise-revenue-recovery-attachments"
	// 	}
	// ]
}
