{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "excise-revenue-recovery-api",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// workers_dev deliberately false (matches what Wrangler would default to anyway once
	// `routes` is set) — the *.workers.dev URL is retired now that the custom domain
	// (excisebakaya.exciseup.in) is the only production entry point. See CLAUDE.md's Auth
	// section / DEPLOY.md's Known Deployment Constraints for the history: this was kept
	// explicitly `true` during Milestone 35's rollout so the old URL didn't disappear before
	// the custom domain was confirmed stable — that grace period is over.
	"workers_dev": false,
	// Widened from /api/* to /* now that this Worker serves the whole app (UI pages + API
	// routes), not just the API — see plan.md. Cutting the real Cloudflare Pages custom domain
	// over to this route is a separate, manual production step (plan.md Section 4.G), done only
	// after this branch is fully verified.
	"routes": [
		{ "pattern": "excisebakaya.exciseup.in/*", "zone_name": "exciseup.in" }
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "excise-revenue-recovery-db",
			"database_id": "4f3e37fd-006a-4bce-b2d3-4bfb8bb16248"
		}
	]
}
